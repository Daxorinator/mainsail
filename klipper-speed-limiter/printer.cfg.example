[speed_limiter]
# Both options below are optional. By default nothing needs to be set:
#
# Volumetric flow cap (mm^3/s). Unset: read the per-filament value the slicer
# embeds in the gcode file (filament_max_volumetric_speed: PrusaSlicer,
# OrcaSlicer, Creality Print), or else infer it from the print. A number forces
# that value for every print; 0 turns flow detection off.
#max_volumetric_flow: 20
#
# Minimum layer time (s). Unset: read from the gcode file's slicer settings.
# A number forces it; 0 disables it.
#min_layer_time: 8
